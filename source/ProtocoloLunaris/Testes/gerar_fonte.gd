const LARGURA_CELULA := 8
const ALTURA_CELULA := 10   # 2 linhas a mais em cima da letra, para os acentos das maiúsculas
const SUBIDA := 2           # quantas linhas a letra desce dentro da célula (espaço do acento)
# No negrito, engrossar 1 px fecharia as frestas destas letras; elas têm desenho próprio.
const NEGRITO_PROPRIO := {
	77: [0x7F, 0x7F, 0x06, 0x0C, 0x06, 0x7F, 0x7F],    # M
	78: [0x7F, 0x7F, 0x0C, 0x18, 0x7F, 0x7F],          # N
	87: [0x3F, 0x7F, 0x60, 0x30, 0x60, 0x7F, 0x3F],    # W
	109: [0x7C, 0x7C, 0x04, 0x78, 0x04, 0x7C, 0x78],   # m
	119: [0x3C, 0x7C, 0x40, 0x30, 0x40, 0x7C, 0x3C],   # w
}
# Acentos: duas linhas de 5 colunas ("#" = pixel aceso).
const ACENTOS := {
	"agudo": ["...#.", "..#.."],
	"grave": [".#...", "..#.."],
	"circunflexo": ["..#..", ".#.#."],
	"til": [".##.#", "#.##."],
	"trema": [".#.#.", "....."],
}
# Letras acentuadas do português e do espanhol: letra de base e acento.
const COMPOSTOS := {
	"á": ["a", "agudo"], "à": ["a", "grave"], "â": ["a", "circunflexo"], "ã": ["a", "til"],
	"é": ["e", "agudo"], "ê": ["e", "circunflexo"], "í": ["i", "agudo"],
	"ó": ["o", "agudo"], "ô": ["o", "circunflexo"], "õ": ["o", "til"],
	"ú": ["u", "agudo"], "ü": ["u", "trema"], "ñ": ["n", "til"], "ç": ["c", "cedilha"],
	"Á": ["A", "agudo"], "À": ["A", "grave"], "Â": ["A", "circunflexo"], "Ã": ["A", "til"],
	"É": ["E", "agudo"], "Ê": ["E", "circunflexo"], "Í": ["I", "agudo"],
	"Ó": ["O", "agudo"], "Ô": ["O", "circunflexo"], "Õ": ["O", "til"],
	"Ú": ["U", "agudo"], "Ü": ["U", "trema"], "Ñ": ["N", "til"], "Ç": ["C", "cedilha"],
	"¿": ["?", "invertido"], "¡": ["!", "invertido"],
}


func _initialize() -> void:
	var destino: String = OS.get_cmdline_user_args()[0]
	DirAccess.make_dir_recursive_absolute(destino)
	_gerar(destino, "lunaris_pixel", false)
	_gerar(destino, "lunaris_pixel_bold", true)
	quit()


## As 5 colunas de um caractere, já na célula alta (bit 0 = linha de cima da célula).
## Letra comum: o desenho desce SUBIDA linhas. Letra acentuada: base + acento por cima.
func _colunas_cheias(caractere: String) -> Array:
	var codigo := caractere.unicode_at(0)
	if GLIFOS.has(codigo):
		var c: Array = []
		for v in GLIFOS[codigo]:
			c.append(int(v) << SUBIDA)
		return c
	var receita: Array = COMPOSTOS[caractere]
	var base: Array = GLIFOS[String(receita[0]).unicode_at(0)]
	var tipo: String = receita[1]
	var cols: Array = []
	if tipo == "invertido":
		# ¿ e ¡: o sinal de cabeça para baixo, descendo 1 linha abaixo da base.
		for v in base:
			var virado := 0
			for linha in 7:
				if int(v) & (1 << linha):
					virado |= 1 << (6 - linha)
			cols.append(virado << (SUBIDA + 1))
		return cols
	var minuscula := caractere == caractere.to_lower() and caractere != caractere.to_upper()
	for v in base:
		var b := int(v)
		if receita[0] == "i":
			b &= ~0x03   # tira o pingo do i
		cols.append(b << SUBIDA)
	if tipo == "cedilha":
		cols[2] |= 1 << (SUBIDA + 7)   # um pixel abaixo da base, no meio
		return cols
	# Maiúscula: acento nas 2 linhas livres do topo. Minúscula: 1 linha acima disso seria
	# fora da célula, então ele fica nas linhas 1 e 2, deixando 1 linha de respiro até a letra.
	var topo := 1 if minuscula else 0
	var desenho: Array = ACENTOS[tipo]
	for linha in 2:
		for coluna in 5:
			if String(desenho[linha])[coluna] == "#":
				cols[coluna] |= 1 << (topo + linha)
	return cols


## Colunas usadas pelo caractere. Letras e sinais perdem as colunas vazias das bordas
## (fonte proporcional); os dígitos ficam todos com 5 colunas, para os números alinharem.
func _colunas(caractere: String) -> Array:
	var codigo := caractere.unicode_at(0)
	var c := _colunas_cheias(caractere)
	if codigo == 32:
		return [0, 0, 0]
	if codigo >= 48 and codigo <= 57:
		return c
	while c.size() > 1 and c[0] == 0:
		c.pop_front()
	while c.size() > 1 and c[-1] == 0:
		c.pop_back()
	return c


func _gerar(destino: String, nome: String, negrito: bool) -> void:
	var caracteres: Array = []
	var codigos: Array = GLIFOS.keys()
	codigos.sort()
	for codigo in codigos:
		caracteres.append(String.chr(codigo))
	caracteres.append_array(COMPOSTOS.keys())
	var por_linha := 16
	var linhas := int(ceil(caracteres.size() / float(por_linha)))
	var img := Image.create(por_linha * LARGURA_CELULA, linhas * ALTURA_CELULA, false, Image.FORMAT_RGBA8)
	img.fill(Color(1, 1, 1, 0))
	# O Godot só reimporta a fonte quando o .fnt muda: ao mexer nos desenhos, troque a versão.
	var texto := "info face=\"%s v3\" size=8 bold=%d italic=0 charset=\"\" unicode=1 stretchH=100 smooth=0 aa=0 padding=0,0,0,0 spacing=0,0\n" % [nome, 1 if negrito else 0]
	texto += "common lineHeight=10 base=8 scaleW=%d scaleH=%d pages=1 packed=0\n" % [img.get_width(), img.get_height()]
	texto += "page id=0 file=\"%s.png\"\n" % nome
	texto += "chars count=%d\n" % caracteres.size()
	for i in caracteres.size():
		var caractere: String = caracteres[i]
		var codigo := caractere.unicode_at(0)
		var cols := _colunas(caractere)
		if negrito and NEGRITO_PROPRIO.has(codigo):
			cols = []
			for v in NEGRITO_PROPRIO[codigo]:
				cols.append(int(v) << SUBIDA)
		elif negrito and codigo != 32:
			var grosso: Array = []
			for k in cols.size() + 1:
				var a: int = cols[k] if k < cols.size() else 0
				var b: int = cols[k - 1] if k > 0 else 0
				grosso.append(a | b)
			cols = grosso
		var x0 := (i % por_linha) * LARGURA_CELULA
		var y0 := (i / por_linha) * ALTURA_CELULA
		for cx in cols.size():
			for linha in ALTURA_CELULA:
				if int(cols[cx]) & (1 << linha):
					img.set_pixel(x0 + cx, y0 + linha, Color.WHITE)
		# yoffset negativo: as 2 linhas do acento ficam acima do topo normal da letra.
		texto += "char id=%d x=%d y=%d width=%d height=%d xoffset=0 yoffset=%d xadvance=%d page=0 chnl=15\n" % [
			codigo, x0, y0, cols.size(), ALTURA_CELULA, 1 - SUBIDA, cols.size() + 1]
	img.save_png(destino.path_join(nome + ".png"))
	var f := FileAccess.open(destino.path_join(nome + ".fnt"), FileAccess.WRITE)
	f.store_string(texto)
	f.close()
	print(nome, ": ", caracteres.size(), " caracteres, imagem ", img.get_size())
